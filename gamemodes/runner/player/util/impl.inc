public EndCameraMoveToSpawn(playerid) {
    TogglePlayerControllable(playerid, true);
	SetCameraBehindPlayer(playerid);
    TogglePlayerLoadObject(playerid);
    return 1;
}

public EndPlayerLoadObject(playerid) {
    TogglePlayerControllable(playerid, true);
	SetCameraBehindPlayer(playerid);
    return 1;
}
