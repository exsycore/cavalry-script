/// Get player position and facing angle is quick
stock bool:SetPlayerPosEx(playerid, Float:x, Float:y, Float:z, Float:a) {
    if (!IsPlayerNPC(playerid)) {
        SetPlayerPos(playerid, x, y ,z);
        SetPlayerFacingAngle(playerid, a);
        return true;
    }
    return false;
}

// check player is near player
stock IsPlayerNearPlayer(playerid, targetid, Float:radius) {
	if (GetPlayerState(playerid) == PLAYER_STATE_SPECTATING || GetPlayerState(targetid) == PLAYER_STATE_SPECTATING)
		return 0;

	static
		Float:fX,
		Float:fY,
		Float:fZ;
	GetPlayerPos(targetid, fX, fY, fZ);

	return (GetPlayerInterior(playerid) == GetPlayerInterior(targetid) && GetPlayerVirtualWorld(playerid) == GetPlayerVirtualWorld(targetid)) && IsPlayerInRangeOfPoint(playerid, radius, fX, fY, fZ);
}

// check player is near vehicle
stock bool:IsPlayerNearVehicle(playerid, vehicleid, Float:radius) {
	static
		Float:fX,
		Float:fY,
		Float:fZ;
	GetVehiclePos(vehicleid, fX, fY, fZ);

	if(IsPlayerInRangeOfPoint(playerid, radius, fX, fY, fZ))
		return true;
	return false;
}

// send chat to near player
stock bool:SendNearbyMessage(playerid, Float:radius, color, const str[], va_args<>) {
	foreach (new i : Player) {
        if (IsPlayerNearPlayer(i, playerid, radius)) {
			va_SendClientMessage(i, color, str, va_start<4>);
        }
    }
	return true;
}

stock bool:TogglePlayerLoadObject(playerid, millis = DEFAULT_LOAD_OBJECT) {
	SetTimerEx("OnPlayerLoadObject", 100, false, "ii", playerid, millis);
	GameTextForPlayer(playerid, "~w~LoadObject ...", millis, 4);
    TogglePlayerControllable(playerid, false);
	SetCameraBehindPlayer(playerid);
    SetTimerEx("EndPlayerLoadObject", millis, false, "i", playerid);
	return true;
}

