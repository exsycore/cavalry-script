hook OnPlayerText(playerid, text[]) {
    if (!playerData[playerid][IsLoggedIn]) {
        va_SendClientMessage(playerid, COLOR_RED, "[!] {FFFFFF}กรุณาล็อกอินเพื่อพิมพ์แชท");
        return 0;
    }
    
    SendText(playerid, text);
    return 0;
}