stock bool:SendText(playerid, text[]) {
    if (!IsPlayerConnected(playerid))
        return false;
    
    if (!playerData[playerid][IsLoggedIn])
        return false;

    SendNearbyMessage(playerid
        , DEFAULT_RADIUS_TEXT
        , -1
        , "{%06x}%s(%d):{FFFFFF} %s"
        , GetPlayerColor(playerid) >>> 8
        , ReturnPlayerRPName(playerid)
        , playerid
        , text
    );

    ApplyAnimation(playerid, "PED", "IDLE_CHAT", 4.1, false, true, true, true, true, true);
    SetTimerEx("CancelChatAnim", 100 * strlen(text), false, "i", playerid);
    SetPlayerChatBubble(playerid, text, CHAT_COLOR_PUPLE, 10.0, 3000);
    return true;
}

