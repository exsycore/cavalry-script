stock bool:IsPlayerAdminEx(playerid) {
    return (playerData[playerid][pAdmin] > 0) ? true : false;
}

stock bool:SendAdminMessage(color, const str[], va_args<>) {
	foreach (new i : Player) {
        if (playerData[i][pAdmin] >= 1) {
			va_SendClientMessage(i, color, str, va_start<2>);
        }
    }
	return true;
}
