hook OnGameModeInit() {
    return 1;
}

hook OnGameModeExit() {
    return 1;
}

hook OnPlayerConnect(playerid) {
    new str[256];
    format(str, sizeof(str), "BUILD: %s - (%s) Vanilla", __date, __time);
    buildVersionName[playerid] = CreatePlayerTextDraw(playerid, 2.000000, 437.000000, str);
    PlayerTextDrawFont(playerid, buildVersionName[playerid], 2);
    PlayerTextDrawLetterSize(playerid, buildVersionName[playerid], 0.104166, 1.000000);
    PlayerTextDrawTextSize(playerid, buildVersionName[playerid], 400.000000, 17.000000);
    PlayerTextDrawSetOutline(playerid, buildVersionName[playerid], 0);
    PlayerTextDrawSetShadow(playerid, buildVersionName[playerid], 0);
    PlayerTextDrawAlignment(playerid, buildVersionName[playerid], 1);
    PlayerTextDrawColor(playerid, buildVersionName[playerid], 0xFFFFFF10);
    PlayerTextDrawBackgroundColor(playerid, buildVersionName[playerid], 255);
    PlayerTextDrawBoxColor(playerid, buildVersionName[playerid], 50);
    PlayerTextDrawUseBox(playerid, buildVersionName[playerid], 0);
    PlayerTextDrawSetProportional(playerid, buildVersionName[playerid], 1);
    PlayerTextDrawSetSelectable(playerid, buildVersionName[playerid], 0);

    PlayerTextDrawShow(playerid, buildVersionName[playerid]);
    return 1;
}

hook OnPlayerDisconnect(playerid, reason) {
    PlayerTextDrawDestroy(playerid, buildVersionName[playerid]);
    return 1;
}
