YCMD:itemsinfo(playerid, const params[], help) {
	if (help) return 1;
	if (playerData[playerid][pAdmin] < 1) return 1;

	ShowItemInfoDialog(playerid, 0);
	return 1;
}

YCMD:skinsinfo(playerid, const params[], help) {
	if (help) return 1;
	if (playerData[playerid][pAdmin] < 1) return 1;

	ShowSkinInfoDialog(playerid, 0);
	SendErrorMessage(playerid, "[ข้อมูล] {FFFFFF}ID ตั้งแต่ 1 ถึง 311 - สกิน!");
	return 1;
}