hook OnGameModeInit() {
    new hour;
    gettime(hour);
    SetTimerEx("setRealTime", TICK_REAL_TIME * 1000, true, "i", hour);
    return 1;
}

hook setRealTime(hour) {
    SetWorldTime(hour);
    return 1;
}

