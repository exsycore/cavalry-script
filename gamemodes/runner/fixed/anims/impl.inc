hook preloadAnimations(playerid) {
    for (new i = 0; i < sizeof(AnimData); ++ i) {
        ApplyAnimation(playerid, AnimData[i], "null", 0.0, false, false, false, false , false, false);
    }
    return 1;
}

hook OnPlayerSpawn(playerid) {
    SetTimerEx("preloadAnimations", 3000 + (GetPlayerPing(playerid) * 20), false, "i", playerid);
    return 1;
}
