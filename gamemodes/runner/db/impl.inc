hook OnGameModeInit() {
    mysql_log(ERROR | WARNING);
	g_SQL = mysql_connect_file("mysql.ini");

	if (mysql_errno(g_SQL) != 0) {
		print("[SYSTEM][DB] Can't connecting to your database.");
		SendRconCommand("exit");
		return 1;
	}

	SetTimer("InitDB", 100, false);
	// SendRconCommand("website "SERVER_WEBSITE"");

	mysql_set_charset("tis620");
    return 1;
}

